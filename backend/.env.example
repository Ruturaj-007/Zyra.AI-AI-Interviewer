# Neon Postgres connection string (Neon dashboard -> Connect -> copy the connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Check the Groq console for a currently available model name and set it here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend origin allowed by CORS (Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Cost control: interviews are capped at this many questions (3-4)
MAX_QUESTIONS=4